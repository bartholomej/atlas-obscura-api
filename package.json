{
  "name": "atlas-obscura-api",
  "version": "5.1.0",
  "description": "Atlas Obscura API in JavaScript. NPM library for scrapping atlasobscura.com",
  "author": "BART! <bart@bartweb.cz>",
  "type": "module",
  "scripts": {
    "start": "tsc -w",
    "prebuild": "rimraf dist",
    "build": "tsdown && cp README.md dist/ && cp LICENSE dist/",
    "build:server": "esbuild ./server/node.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "server": "tsx server/node.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "tsc": "tsc",
    "tsc:server": "tsc -p server",
    "demo": "tsx demo",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "yarn test --coverage",
    "publish:next": "yarn && yarn build && yarn test --coverage && npm publish --folder dist --tag beta",
    "postversion": "git push && git push --follow-tags",
    "release:beta": "npm version preminor --preid=beta -m \"chore(update): prelease %s β\"",
    "prerelease:beta": "npm version prerelease --preid=beta -m \"chore(update): prelease %s β\"",
    "release:patch": "git checkout master && npm version patch -m \"chore(update): patch release %s 🐛\"",
    "release:minor": "git checkout master && npm version minor -m \"chore(update): release %s 🚀\"",
    "release:major": "git checkout master && npm version major -m \"chore(update): major release %s 💥\"",
    "prepare": "husky"
  },
  "dependencies": {
    "got-scraping": "^4.2.2",
    "node-html-parser": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.11",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-istanbul": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "hono": "^4.13.20",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rolldown": "1.3.3",
    "rolldown-plugin-dist-package": "^1.1.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "repository": {
    "url": "git+https://github.com/bartholomej/atlas-obscura-api.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/bartholomej/atlas-obscura-api/issues"
  },
  "homepage": "https://github.com/bartholomej/atlas-obscura-api#readme",
  "keywords": [
    "travellers",
    "atlasobscura",
    "places",
    "maps",
    "nodejs",
    "node",
    "typescript",
    "scraper",
    "parser",
    "api"
  ],
  "engines": {
    "node": ">= 20"
  },
  "license": "MIT",
  "lint-staged": {
    "*.ts": "eslint --cache --fix"
  },
  "packageManager": "yarn@4.19.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.fetch.js",
  "browser": "./dist/index.fetch.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.fetch.js",
      "worker": "./dist/index.fetch.js",
      "react-native": "./dist/index.fetch.js",
      "browser": "./dist/index.fetch.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
